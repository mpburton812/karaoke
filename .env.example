# Turso (server only — never use VITE_ prefix for database secrets)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# API
PORT=3001
JWT_SECRET=generate-a-long-random-string-at-least-32-chars

# Frontend (optional in local dev — Vite proxies /api when empty)
VITE_API_URL=

# Optional: override Vite proxy target (default http://localhost:3001)
# VITE_API_PROXY_TARGET=http://localhost:3001
